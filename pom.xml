<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot のバージョン管理（依存ライブラリのバージョンをまとめて決めてくれる） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.hatsu3140</groupId>
    <artifactId>piano-to-guitar-tab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>piano-to-guitar-tab</name>
    <description>ピアノ譜(MusicXML)からソロギター用TAB譜(Guitar Pro)を生成するアプリ</description>

    <!-- converter: 変換ロジック本体（Spring に依存しない普通の Java） / web: 画面とAPI -->
    <modules>
        <module>converter</module>
        <module>web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
